# Copy these settings into .env in the directory where you launch NoPainMD.

# Directory to browse; relative paths resolve from the launch directory.
# Recommended: keep '.' so NoPainMD uses your current workspace as designed.
NOPAINMD_BASE_DIR=.

# Server hostname or address; unset defaults to localhost, or hostname -f over SSH.
# Uncomment to override automatic host selection.
# NOPAINMD_HOST=localhost

# Server port; use 0 to choose an available port automatically.
NOPAINMD_PORT=3000

# Literal text font name; defaults to bundled Open Sans (code blocks use monospace).
NOPAINMD_FONT="Open Sans"

# Scale text and document content as a percentage; 100 means normal size.
NOPAINMD_FONT_ZOOM=100

# Enable raw HTML and embedded SVG unless a saved browser choice overrides it.
# When disabled, show their source text; Markdown images and Mermaid still render.
NOPAINMD_HTML_ENABLED=true

# Maximum indexing time in milliseconds; 5000 means 5 seconds.
NOPAINMD_INDEX_MAX_MS=5000

# Maximum files and directories in the tree, including collapsed entries.
NOPAINMD_INDEX_MAX_NODES=10000

# Restart after changing the base directory, host, or port; use Reload for other settings.

# Optional read-error diagnostics use Node's logger and must be enabled in the shell:
# NODE_DEBUG=nopainmd nopainmd
